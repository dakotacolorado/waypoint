{
  "name": "@dakotajp/waypoint",
  "version": "0.1.0",
  "description": "A task tracker for people and agents: epics, stories and tasks with dependencies and derived status, over an HTTP API on SQLite.",
  "keywords": ["task-tracker", "agents", "claude-code", "sqlite", "epics", "backlog"],
  "homepage": "https://github.com/dakotacolorado/waypoint",
  "bugs": { "url": "https://github.com/dakotacolorado/waypoint/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/dakotacolorado/waypoint.git" },
  "license": "MIT",
  "author": "Dakota Parker",
  "type": "module",
  "bin": { "waypoint": "dist/cli.js" },
  "files": ["dist", "skill", "openapi.json"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node src/cli.ts --db .waypoint-dev.db",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node src/stamp.ts dist/build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec": "node src/spec.ts && openapi-to-md openapi.json docs/API.md && redocly build-docs openapi.json -o docs/index.html",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.1",
    "@types/node": "^24",
    "openapi-to-md": "^1.3.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": { "access": "public" }
}
