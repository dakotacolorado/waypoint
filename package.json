{
  "name": "@dakotajp/waypoint",
  "version": "0.2.1",
  "description": "A task tracker with dependency and status management.",
  "keywords": [
    "task-tracker",
    "dependencies",
    "mcp",
    "sqlite",
    "api"
  ],
  "homepage": "https://github.com/dakotacolorado/waypoint",
  "bugs": {
    "url": "https://github.com/dakotacolorado/waypoint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dakotacolorado/waypoint.git"
  },
  "license": "MIT",
  "author": "Dakota Parker",
  "type": "module",
  "bin": {
    "waypoint": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui",
    "docs",
    "openapi.json",
    "mcp.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts --db .waypoint-dev.db",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node src/build.ts dist/build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec": "node src/spec.ts",
    "prepack": "npm run build",
    "prepare": "npm run build && (git config core.hooksPath .githooks 2>/dev/null || true)"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.1",
    "@types/node": "^24",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
