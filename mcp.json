      "description": "Returns a task.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 8,
            "description": "The task's ID, or a prefix of it at least 8 characters long, such as its shortId."
          }
        },
        "required": [
          "taskId"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
