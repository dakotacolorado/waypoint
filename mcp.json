{
  "instructions": "waypoint: A task tracker with dependency and status management.\n\n- status is backlog, in_progress, review, done or cancelled; done and cancelled are the closed statuses.\n- A task depends on the tasks in its dependsOn, and is blocked by those still open (blockedBy). It is ready when it is in backlog and every task it depends on is closed.\n- A task can move to in_progress, review or done once every task it depends on is closed, and to done once every criterion is met and every subtask is closed. Subtasks follow the same rule among themselves.\n- In update_task, criteria and subtasks are whole lists matched by id; a field left out of an entry keeps its value. To mark one criterion met, send met: true on that entry only.\n- A task ID may be given as its shortId.",
  "tools": [
    {
      "name": "list_tasks",
      "title": "List tasks",
      "description": "Returns tasks matching every filter given, oldest first. Cancelled tasks are left out unless status is cancelled or includeCancelled is true.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "status": {
            "description": "Only tasks with this status.",
            "type": "string",
            "enum": [
              "backlog",
              "in_progress",
              "review",
              "done",
              "cancelled"
            ]
          },
          "ready": {
            "description": "true for only tasks that can be started now.",
            "type": "boolean"
          },
          "label": {
            "description": "Only tasks with this label, by ID or name.",
            "type": "string"
          },
          "assignee": {
            "description": "Only tasks assigned to this; none for unassigned tasks.",
            "type": "string"
          },
          "includeCancelled": {
            "type": "boolean"
          },
          "maxResults": {
            "description": "The most results to return. Default 100.",
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "nextToken": {
            "description": "The nextToken from the previous page.",
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "create_task",
      "title": "Create a task",
      "description": "Creates a task in backlog, unless status says otherwise.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "A short name for the task."
          },
          "description": {
            "type": "string",
            "maxLength": 20000,
            "description": "What the task is, in Markdown."
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "in_progress",
              "review",
              "done",
              "cancelled"
            ],
            "description": "Where it stands. `done` and `cancelled` are the closed statuses."
          },
          "dependsOn": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The IDs of the tasks this one depends on."
          },
          "subtasks": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "description": "The ID of an existing subtask. Omit it for a new one.",
                  "type": "string"
                },
                "title": {
                  "description": "A short name for the step. Required for a new subtask.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "description": "What the step is, in Markdown.",
                  "type": "string",
                  "maxLength": 20000
                },
                "status": {
                  "description": "Where the step stands. Omit it to leave it as it stands when the write lands; a new subtask starts in `backlog`.",
                  "type": "string",
                  "enum": [
                    "backlog",
                    "in_progress",
                    "review",
                    "done",
                    "cancelled"
                  ]
                },
                "dependsOn": {
                  "description": "The IDs of subtasks of the same task this one depends on.",
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "The steps of the work, in order. On update this is the whole list: a subtask left out is removed."
          },
          "criteria": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "description": "The ID of an existing criterion. Omit it for a new one.",
                  "type": "string"
                },
                "text": {
                  "description": "What must be true. Required for a new criterion.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "met": {
                  "description": "Whether it is met. Omit it to leave it as it stands when the write lands.",
                  "type": "boolean"
                }
              }
            },
            "description": "The acceptance criteria, in order. On update this is the whole list: a criterion left out is removed."
          },
          "labels": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Labels, each by ID or name."
          },
          "assignee": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "description": "Who the task is assigned to; null for no one."
          },
          "clientToken": {
            "description": "A unique string; retrying with it returns what the first request created.",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "title"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_task",
